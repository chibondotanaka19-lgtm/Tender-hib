rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData(request.auth.uid).role == role;
    }

    // --- Users ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['name', 'email', 'role']) && 
               data.name is string && data.name.size() <= 100 &&
               data.email is string && data.email.size() <= 100 &&
               data.role in ['consumer', 'organization'];
      }

      allow get: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().email == request.auth.token.email;
      allow update: if isOwner(userId) && 
                    isValidUser(incoming()) && 
                    incoming().email == existing().email && 
                    incoming().role == existing().role &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'organizationName', 'contactEmail', 'phoneNumber', 'description', 'updatedAt']);
    }

    // --- Tenders ---
    match /tenders/{tenderId} {
      function isValidTender(data) {
        return data.keys().hasAll(['title', 'description', 'organizationId', 'organizationName', 'category', 'budget', 'deadline', 'status', 'createdAt']) &&
               data.title is string && data.title.size() <= 200 &&
               data.description is string && data.description.size() <= 5000 &&
               data.organizationId == request.auth.uid &&
               data.status in ['open', 'closed', 'under-review', 'awarded'];
      }

      allow list: if true; // Publicly browseable
      allow get: if true;
      allow create: if isRole('organization') && isValidTender(incoming()) && incoming().createdAt == request.time;
      allow update: if isRole('organization') && 
                    existing().organizationId == request.auth.uid && 
                    isValidTender(incoming()) &&
                    (
                      (existing().status == 'open' && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'budget', 'deadline', 'status', 'updatedAt'])) ||
                      (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                    );
    }

    // --- Bids ---
    match /tenders/{tenderId}/bids/{bidId} {
      function isValidBid(data) {
        return data.keys().hasAll(['tenderId', 'tenderTitle', 'userId', 'userName', 'proposal', 'amount', 'status', 'createdAt']) &&
               data.tenderId == tenderId &&
               data.userId == request.auth.uid &&
               data.proposal is string && data.proposal.size() <= 5000 &&
               data.amount is number &&
               data.status in ['submitted', 'accepted', 'rejected'];
      }

      function getTenderData() {
        return get(/databases/$(database)/documents/tenders/$(tenderId)).data;
      }

      function isTenderOwner() {
        return getTenderData().organizationId == request.auth.uid;
      }

      allow list: if isSignedIn() && (isOwner(resource.data.userId) || isTenderOwner());
      allow get: if isSignedIn() && (isOwner(resource.data.userId) || isTenderOwner());
      
      allow create: if isRole('consumer') && 
                    isValidBid(incoming()) && 
                    getTenderData().status == 'open' &&
                    incoming().createdAt == request.time;
      
      allow update: if isSignedIn() && (
        // Consumer can update their own proposal if not yet decided
        (isOwner(existing().userId) && 
         existing().status == 'submitted' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['proposal', 'amount', 'updatedAt']) &&
         getTenderData().status == 'open') ||
        // Organization can award/reject
        (isTenderOwner() && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
      );

      // --- Messages ---
      match /messages/{messageId} {
        function isValidMessage(data) {
          return data.senderId == request.auth.uid &&
                 data.content is string && data.content.size() <= 2000 &&
                 data.createdAt == request.time;
        }

        function isPartToBid() {
          let bid = get(/databases/$(database)/documents/tenders/$(tenderId)/bids/$(bidId)).data;
          let tender = get(/databases/$(database)/documents/tenders/$(tenderId)).data;
          return bid.userId == request.auth.uid || tender.organizationId == request.auth.uid;
        }

        allow read, list: if isSignedIn() && isPartToBid();
        allow create: if isSignedIn() && isPartToBid() && isValidMessage(incoming());
      }
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn(); 
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']);
    }

    // --- Collection Group: Bids ---
    match /{path=**}/bids/{bidId} {
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        get(/databases/$(database)/documents/tenders/$(resource.data.tenderId)).data.organizationId == request.auth.uid
      );
    }

    // --- Collection Group: Messages ---
    match /{path=**}/messages/{messageId} {
      allow list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }
  }
}
